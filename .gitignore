# --- PYTHON JUNK ---
__pycache__/
*.py[cod]
*$py.class

# --- JAVA COMPILED JUNK ---
*.class
# Ignore the compiled binaries, but keep the .gitkeep file to ensure the bin directory is tracked
java_backend/bin/*
!java_backend/bin/.gitkeep

# --- IDE / EDITOR JUNK (IntelliJ & VS Code) ---
.idea/
*.iml
.vscode/